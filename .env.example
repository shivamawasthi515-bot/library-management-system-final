PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=hlms
JWT_SECRET=change-this-super-secret-value
JWT_EXPIRES_IN=7d
DEFAULT_BORROW_DAYS=14
FINE_PER_DAY=1
SEARCH_CANDIDATE_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# Public URL used in password-reset emails (no trailing slash)
APP_URL=http://localhost:3001

# Gmail SMTP – set EMAIL_USER to your Gmail address and EMAIL_PASS to a
# 16-character Gmail App Password (Google Account → Security → App Passwords).
# Leave blank to skip email sending (reset URL will not be emailed).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional integration placeholders
USE_OPENAI_SEARCH=false
OPENAI_API_KEY=
EMAIL_PROVIDER=
SMS_PROVIDER=
